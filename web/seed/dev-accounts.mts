// Gives three sample users a password, so you can sign in locally as each role:
//   admin@example.com (admin), reviewer@example.com (reviewer), ana@example.com (user)
// All three use DEV_PASSWORD below.
//
// LOCAL ONLY. `npm run db:seed:local` loads the output into the local database.
// Never load it into the live database: this password is in the code, so anyone
// who can read the repo could sign in as an admin.

import { writeFileSync } from "node:fs";
import { hashPassword } from "../src/server/password.ts";

const DEV_PASSWORD = "sample-password-123";
const ACCOUNTS = ["u_admin", "u_reviewer", "u_ana"];

const now = Date.now();
const lines = [
  "-- GENERATED by seed/dev-accounts.mts (not committed). LOCAL DEVELOPMENT ONLY.",
  "DELETE FROM accounts WHERE provider_id = 'credential';",
];
for (const userId of ACCOUNTS) {
  const hash = await hashPassword(DEV_PASSWORD);
  // For email sign-in Better Auth stores account_id = the user's id and provider_id = "credential".
  lines.push(
    `INSERT INTO accounts (id, user_id, account_id, provider_id, password, created_at, updated_at) ` +
      `VALUES ('acc_${userId}', '${userId}', '${userId}', 'credential', '${hash}', ${now}, ${now});`,
  );
}

writeFileSync(new URL("./dev-accounts.sql", import.meta.url), lines.join("\n") + "\n");
console.log(`Wrote seed/dev-accounts.sql (${ACCOUNTS.length} accounts)`);
