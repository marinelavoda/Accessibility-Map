!theme plain
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam ArrowFontSize 11
skinparam package {
  BorderColor #6E6E6E
  FontStyle bold
}
skinparam rectangle {
  BorderColor #8A8A8A
  FontStyle bold
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #333333
  BackgroundColor<<P1>> #E4E4E4
  BorderColor<<P1>> #8C8C8C
  BackgroundColor<<P2>> #F3F3F3
  BorderColor<<P2>> #B0B0B0
  FontColor<<P2>> #6A6A6A
  BackgroundColor<<external>> #EEF3FA
  BorderColor<<external>> #6F86A6
  BackgroundColor<<script>> #FFF6E5
  BorderColor<<script>> #B08A3E
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #333333
  BackgroundColor<<P1>> #E4E4E4
  BackgroundColor<<P2>> #F3F3F3
}
skinparam storage {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #C9B458
  FontSize 11
}
hide stereotype
